# Copy to .env and fill in values
# cp .env.example .env

APP_NAME="Tech2Globe Ops"
APP_ENV=local
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000/
APP_ENC_KEY=

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=production_crm
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# AWS SES SMTP
MAIL_MAILER=smtp
